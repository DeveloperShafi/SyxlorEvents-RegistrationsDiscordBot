{
  "name": "syxlor-events-registrations",
  "version": "1.0.0",
  "description": "Professional Discord event-registration and event-management platform for Minecraft tournaments",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "events",
    "registrations",
    "minecraft",
    "tournaments"
  ],
  "author": "Anam / Helpse",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "discord.js": "^14.15.3",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
